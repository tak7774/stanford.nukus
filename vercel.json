{
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "redirects": [
    { "source": "/backend/:path*", "destination": "/", "permanent": false },
    { "source": "/requirements.txt", "destination": "/", "permanent": false }
  ]
}
