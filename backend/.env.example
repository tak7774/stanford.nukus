# Copy this file to backend/.env and fill in the values.
# backend/.env is ignored by git — never commit real secrets.

# Supabase → Project Settings → Database → Connection string → URI (Transaction pooler, port 6543)
# Leave empty to use a local SQLite test database instead.
DATABASE_URL=

# Any long random string. Generate one with:
#   backend/.venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 on your computer, 0 (or unset) on Vercel
DJANGO_DEBUG=1
