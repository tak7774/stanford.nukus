{
  // Use the project's own Python (with Django installed) instead of the system one
  "python.defaultInterpreterPath": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe",
  // Let Pylance find the Django project modules (config, core)
  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],
  "python.terminal.activateEnvironment": true,
  "files.exclude": {
    "**/__pycache__": true
  },
  // Python Environments extension: use the project's venv, not system Python 3.14
  "python-envs.defaultEnvManager": "ms-python.python:venv",
  "python-envs.pythonProjects": [
    {
      "path": "backend",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    }
  ]
}
